{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobbsok.local/schemas/polish.schema.json",
  "title": "Polish layer",
  "description": "Stage 3 (EDITOR). Field-level replacements only: return the fields you changed, with a reason each. There is no regenerate-everything mandate; when reconstruction is genuinely cheaper upstream, submit a RERUN review instead of rebuilding the package here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_role",
    "binding",
    "changes",
    "keystone_disposition"
  ],
  "properties": {
    "artifact_role": {
      "const": "POLISH_LAYER"
    },
    "binding": {
      "type": "object",
      "description": "Written by the tool at submit.",
      "additionalProperties": false,
      "required": [
        "run_id",
        "job_id",
        "employer",
        "title",
        "evidence_fingerprint",
        "policy_fingerprint",
        "inputs"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^r[0-9]{8}-[0-9]{6}-[a-f0-9]{6}(?:/branches/[a-z0-9][a-z0-9_-]{0,31})?$"
        },
        "job_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{2,60}$"
        },
        "employer": {
          "type": "string",
          "minLength": 2
        },
        "title": {
          "type": "string",
          "minLength": 2
        },
        "evidence_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "What this stage consumed as fact: frozen authorities, evidence index, baseline map, CV baseline, this vacancy and the upstream artifacts. Staleness is this hash recomputed."
        },
        "policy_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Playbook plus consumed writing policy. Provenance only; a policy edit never invalidates an artifact."
        },
        "inputs": {
          "type": "object",
          "description": "Upstream artifact name -> artifact hash.",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "cv": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 70,
          "description": "One rendered line, a function not a list. Uppercased at render."
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "competencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "employment_overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "employment_id": {
                "type": "string",
                "pattern": "^EMP_[A-Z0-9_]+$"
              },
              "bullets": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              }
            },
            "required": [
              "employment_id",
              "bullets"
            ]
          },
          "minItems": 0,
          "description": "Keyed by baseline employment_id. A present override fully replaces that employment's bullets; an empty array renders none."
        },
        "tools_line": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional VERKTOY line, so tool lists leave the bullets."
        }
      },
      "description": "Replacement fields only: a present field replaces, an absent field inherits, an empty array clears."
    },
    "letter": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "opening": {
              "type": "string",
              "minLength": 1
            },
            "body_paragraphs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "closing": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": "Any subset of the three letter fields; body_paragraphs replaces the whole array."
        }
      ]
    },
    "form_answers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "question",
          "answer"
        ]
      },
      "minItems": 0
    },
    "keystone_disposition": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^K[0-9]$"
          },
          "disposition": {
            "enum": [
              "KEPT",
              "REWORDED",
              "REMOVED"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        },
        "required": [
          "id",
          "disposition",
          "reason"
        ]
      },
      "minItems": 0,
      "description": "One entry per keystone the Advocate marked. Preserve the argument function; rewording is free."
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "reason": {
            "enum": [
              "SCREEN_OUT",
              "TRUTH",
              "TONE",
              "PERSONALITY",
              "DIFFERENTIATION",
              "SOCIAL_RISK",
              "COMPLEMENTARITY",
              "CAPACITY",
              "TIC"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        },
        "required": [
          "field",
          "reason"
        ]
      },
      "minItems": 0
    },
    "added_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EV:(WORK|EDU|OTHER)#(file|preamble|[0-9]{3}-[a-z0-9-]{1,60})$"
      },
      "minItems": 0
    },
    "outside_brief_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EV:(WORK|EDU|OTHER)#(file|preamble|[0-9]{3}-[a-z0-9-]{1,60})$"
      },
      "minItems": 0
    },
    "writer_note": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    }
  }
}
